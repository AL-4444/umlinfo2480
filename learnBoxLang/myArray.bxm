<h3>My Array</h3>
<p id="a07e67e4-5a02-4b59-ae4c-1c6ef8035771" class=""><strong>Exercise</strong>: Create some objects using the same model
    you created on the MyObjects page. Populate three more of them with three more books from the 10 Books Exercise. Put each of the objects in its
    own index in an Array and dump it out. Are you starting to see how an array of objects can be a powerful
    thing? If not, no stress but stay tuned. I know that this exercise is repetitive. In a few screens we are
    going to see how we can make the computer create the objects and arrays we want more easily and
    automatically. For now though, just type it out.</p>





<h3>My Array</h3>



<bx:set allMyBooks = [
    {
        title: "The Paris Architect",
        length: "384 pages",
        yearPublished: 2013,
        publisher: {
            name: "Sourcebooks Landmark",
            location: "United States"
        },
        format: "Paperback",
        author: {
            firstName: "Charles",
            lastName: "Belfoure"
        },
        genres: ["Historical Fiction"],
        language: "English",
        condition: "Good",
        publicationCountry: "United States",
        price: 16.48
    },
    {
        title: "Elizabeth & Margaret: The Intimate World of the Windsor Sisters",
        length: "400 pages",
        yearPublished: 2021,
        publisher: {
            name: "Grand Central",
            location: "United States"
        },
        format: "Hardcover",
        author: {
            firstName: "Andrew",
            lastName: "Morton"
        },
        genres: ["Biography"],
        language: "English",
        condition: "Good",
        publicationCountry: "United States",
        price: 28.00
    },
    {
        title: "The Bronze Bow",
        length: "256 pages",
        yearPublished: 1961,
        publisher: {
            name: "Houghton Mifflin",
            location: "United States"
        },
        format: "Paperback",
        author: {
            firstName: "Elizabeth George",
            lastName: "Speare"
        },
        genres: ["Historical Fiction"],
        language: "English",
        condition: "Good",
        publicationCountry: "United States",
        price: 7.99
    },
    {
        title: "Children of Dune",
        length: "416 pages",
        yearPublished: 1976,
        publisher: {
            name: "Ace Books",
            location: "United States"
        },
        format: "Hardcover",
        author: {
            firstName: "Frank",
            lastName: "Herbert"
        },
        genres: ["Science Fiction"],
        language: "English",
        condition: "New",
        publicationCountry: "United States",
        price: 28.19
    },
    {
        title: "The Evil Eye: The History, Mystery, and Magic of the Quiet Curse",
        length: "256 pages",
        yearPublished: 2023,
        publisher: {
            name: "Weiser Books",
            location: "United States"
        },
        format: "Paperback",
        author: {
            firstName: "Antonio",
            lastName: "Pagliarulo"
        },
        genres: ["Nonfiction"],
        language: "English",
        condition: "New",
        publicationCountry: "United States",
        price: 18.95
    }
] />

<bx:output>
    <bx:set totalCost = 0 />

    <bx:loop array="#allMyBooks#" item="book">

        <p><strong>Title:</strong> #book.title#</p>

        <p><strong>Length:</strong> #book.length#</p>

        <p><strong>Year Published:</strong>
            #book.yearPublished#
        </p>

        <p><strong>Publisher:</strong>
            #book.publisher.name#,
            #book.publisher.location#
        </p>

        <p><strong>Format:</strong> #book.format#</p>

        <p><strong>Author:</strong>
            #book.author.firstName#
            #book.author.lastName#
        </p>

        <p><strong>Genres:</strong>
            #book.genres.join(", ")#
        </p>

        <p><strong>Language:</strong>
            #book.language#
        </p>

        <p><strong>Book Condition:</strong>
            #book.condition#
        </p>

        <p><strong>Publication Country:</strong>
            #book.publicationCountry#
        </p>

        <p><strong>Price:</strong>
            $#numberFormat(book.price, "0.00")#
        </p>

        <hr />

        <bx:set totalCost = totalCost + book.price />

    </bx:loop>

    <p><strong>Total Cost:</strong>
        $#numberFormat(totalCost, "0.00")#
    </p>
</bx:output>


